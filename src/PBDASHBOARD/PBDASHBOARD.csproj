      <_ContentIncludedByDefault Remove="wwwroot\static\js\main.90d12857.chunk.js" />
      <_ContentIncludedByDefault Remove="wwwroot\static\js\main.90d12857.chunk.js.map" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="ClientApp\build" />
    </ItemGroup>

