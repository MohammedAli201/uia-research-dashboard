      <_ContentIncludedByDefault Remove="wwwroot\static\index.html" />
      <_ContentIncludedByDefault Remove="wwwroot\static\js\2.9cae20a4.chunk.js" />
      <_ContentIncludedByDefault Remove="wwwroot\static\js\2.9cae20a4.chunk.js.LICENSE.txt" />
      <_ContentIncludedByDefault Remove="wwwroot\static\js\2.9cae20a4.chunk.js.map" />
      <_ContentIncludedByDefault Remove="wwwroot\static\js\main.84933c05.chunk.js" />
      <_ContentIncludedByDefault Remove="wwwroot\static\js\main.84933c05.chunk.js.map" />
      <_ContentIncludedByDefault Remove="wwwroot\static\js\runtime-main.d5ff2b38.js" />
